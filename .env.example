# Copy to .env and fill in. In Coolify, set these as Environment Variables instead.

# --- Required ---
# Get a token from @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Your chat/user id. Message your bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}
# (or message @userinfobot to get your numeric id).
TELEGRAM_CHAT_ID=987654321

# --- Optional (defaults shown) ---
# Local timezone for timestamps in messages, e.g. Europe/London, America/New_York.
TZ=UTC
# How often to check, in seconds.
INTERVAL_SECONDS=5
# Per-target TCP connect timeout, in seconds.
CHECK_TIMEOUT=1.5
# Consecutive failed checks before declaring the internet "down".
FAIL_THRESHOLD=3
# Comma-separated host:port TCP targets to probe. Online = any one connects.
# Mixes an HTTPS (443) and a DNS (53) check so it works even if one port is blocked.
TARGETS=1.1.1.1:443,8.8.8.8:53
# Send a short "monitor is online" ping to Telegram on startup.
STARTUP_PING=true

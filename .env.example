# Copy to .env and fill in. In Coolify, set these as Environment Variables instead.

# --- Required ---
# Get a token from @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Your chat/user id. Message your bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}
# (or message @userinfobot to get your numeric id).
TELEGRAM_CHAT_ID=987654321

# --- Optional (defaults shown) ---
# Local timezone for timestamps in messages, e.g. Europe/London, America/New_York.
TZ=UTC
# How often to check, in seconds.
INTERVAL_SECONDS=5
# Per-target TCP connect timeout, in seconds.
CHECK_TIMEOUT=1.5
# Consecutive failed checks before declaring the internet "down".
FAIL_THRESHOLD=3
# Comma-separated host:port TCP targets to probe. Online = any one connects.
# Mixes an HTTPS (443) and a DNS (53) check so it works even if one port is blocked.
TARGETS=1.1.1.1:443,8.8.8.8:53
# Send a short "monitor is online" ping to Telegram on startup.
STARTUP_PING=true

# --- Post-recovery speed test ---
# After the connection recovers, measure ping, download and upload and send it
# as a separate Telegram message. Useful for spotting when you've come back on
# the slower 4G backup instead of your main line. The same test is available on
# demand via the /speedtest command.
# NOTE: with the defaults below each run uses ~120 MB (100 MB down + 20 MB up).
# Lower SPEED_TEST_BYTES / SPEED_TEST_UPLOAD_BYTES if your 4G backup is metered.
SPEED_TEST=true
# File to download for the measurement (Cloudflare lets you request N bytes).
# Data is streamed and discarded as it arrives -- never written to disk.
SPEED_TEST_URL=https://speed.cloudflare.com/__down?bytes=100000000
# How much to download, in bytes (100 MB).
SPEED_TEST_BYTES=100000000
# Overall timeout for each part of the speed test, in seconds.
SPEED_TEST_TIMEOUT=120
# Ping (TCP-connect latency).
SPEED_TEST_PING=true
SPEED_TEST_PING_HOST=1.1.1.1:443
# Upload test (POSTs a throwaway buffer to Cloudflare and times it).
SPEED_TEST_UPLOAD=true
SPEED_TEST_UPLOAD_BYTES=20000000
# If the download is below this many Mbps, the message flags it as "probably the
# 4G backup". Default 100 suits a fibre main line; set to your own speed, or 0
# to disable the warning.
SPEED_TEST_SLOW_MBPS=100

# Listen for commands you message the bot (/speedtest, /status, /help) and
# respond on demand. Only messages from TELEGRAM_CHAT_ID are acted on.
LISTEN_COMMANDS=true
